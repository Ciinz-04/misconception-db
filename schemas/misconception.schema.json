{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "misconception.schema.json",
  "title": "全域迷思概念",
  "type": "object",
  "required": [
    "mc_id",
    "name",
    "belief",
    "correct_conception",
    "nature_type",
    "origin",
    "evidence",
    "evidence_tier",
    "units",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "mc_id": {
      "type": "string",
      "pattern": "^MC-(NUM|ALG|FUN|COO|GEO|STA|PRB|TRN)-\\d{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15
    },
    "belief": {
      "type": "string",
      "minLength": 1
    },
    "correct_conception": {
      "type": "string",
      "minLength": 1
    },
    "nature_type": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "T7",
        "T8"
      ]
    },
    "secondary_type": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "T7",
        "T8",
        null
      ]
    },
    "old_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "overgeneralization",
          "representation",
          "instruction",
          "intuition",
          "visual",
          "unknown"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "level",
          "source",
          "source_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "level": {
            "enum": [
              "E1",
              "E2",
              "E4"
            ]
          },
          "source": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "grade": {
            "type": "string",
            "pattern": "^G[1-9]$"
          },
          "rate": {
            "type": "string"
          },
          "example": {
            "type": "string"
          }
        }
      }
    },
    "evidence_tier": {
      "enum": [
        "verified",
        "unverified"
      ]
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "related_mc": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MC-[A-Z]{3}-\\d{3}$"
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "nature_type": {
            "const": "T2"
          }
        }
      },
      "then": {
        "required": [
          "old_rule",
          "trigger"
        ],
        "properties": {
          "old_rule": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nature_type": {
            "const": "T2"
          }
        }
      },
      "then": {
        "properties": {
          "origin": {
            "contains": {
              "const": "overgeneralization"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_tier": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "level": {
                  "enum": [
                    "E1",
                    "E2"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}