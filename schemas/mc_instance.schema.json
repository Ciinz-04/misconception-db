{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mc_instance.schema.json",
  "title": "知識點實例",
  "type": "object",
  "required": [
    "instance_id",
    "kp_id",
    "mc_id",
    "nature_type",
    "anchor",
    "error_patterns",
    "remediation",
    "evidence_tier"
  ],
  "additionalProperties": false,
  "properties": {
    "instance_id": {
      "type": "string",
      "pattern": "^.+#MC-[A-Z]{3}-\\d{3}$"
    },
    "kp_id": {
      "type": "string"
    },
    "mc_id": {
      "type": "string",
      "pattern": "^MC-[A-Z]{3}-\\d{3}$"
    },
    "nature_type": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "T7",
        "T8"
      ],
      "description": "繼承全域迷思，用來檢查必填欄位"
    },
    "anchor": {
      "type": "object",
      "required": [
        "type",
        "step_desc"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "step",
            "concept",
            "formulation"
          ]
        },
        "step_desc": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "error_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "desc",
          "examples"
        ],
        "additionalProperties": false,
        "properties": {
          "desc": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "trigger_conditions": {
      "type": "object"
    },
    "buggy_rule": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "item_template": {
      "type": "string",
      "description": "item_template 檔的 ID"
    },
    "diagnostic_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediation": {
      "type": "object",
      "required": [
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "route_to": {
          "type": "object",
          "properties": {
            "step_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "prerequisite_kp": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "evidence_tier": {
      "enum": [
        "verified",
        "unverified"
      ]
    },
    "checks": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "nature_type": {
            "enum": [
              "T1",
              "T2",
              "T6",
              "T8"
            ]
          }
        }
      },
      "then": {
        "required": [
          "trigger_conditions",
          "buggy_rule",
          "item_template",
          "diagnostic_items"
        ]
      }
    }
  ]
}