# 複製這個檔案成 .env，再填入自己的金鑰（.env 不會被上傳到 GitHub）
ANTHROPIC_API_KEY=
# 模型名稱請到 https://docs.claude.com/en/docs/about-claude/models 查目前可用的名稱
ANTHROPIC_MODEL=

# Langfuse（https://cloud.langfuse.com 註冊後，在專案 Settings → API Keys 建立）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
